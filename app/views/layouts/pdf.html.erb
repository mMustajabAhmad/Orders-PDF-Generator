<!DOCTYPE html>
<html lang="en">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= wicked_pdf_javascript_include_tag "number_pages" %>
    <title>Order PDF</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
            body { font-family: 'Inter', sans-serif; color: #2D3958; margin: 0; padding: 20px; min-height: 297mm; }
                
                table {
                    border-collapse: collapse;  
                    width: 100%;
                }

                .quarter {
                    width: 50%;
                }
                
                .from_bill_section_heading {
                    color: #6D6D6D;
                    font-weight: 500;
                    margin-bottom: 10px;
                }

                .section_heading, .order_section_heading {
                    color: #6D6D6D;
                    color: #4B4B4B;
                    font-weight: 500;
                    background-color: #F4F7FC;
                    margin-bottom: 10px;
                    padding: 16px;
                    border-radius: 5px;
                }

                .section_details, .food_items_total {
                    color: #6D6D6D;
                }

                
                .total {
                    font-weight: 600;
                    font-size: 16px;
                    color: #2D3958;
                    width: 100%;
                    margin-bottom: 10px;
                }
                
                .total_wrapper, .item_value {
                    text-align: right;
                }

                .header, .from_bill_section, .total {
                    margin-bottom: 44px;
                }

                th {
                    color: #6D6D6D;
                    font-weight: lighter;
                    padding-bottom: 10px;
                    border-bottom: 1px solid #ddd;
                }
                
                .order_section_header {
                    margin-top: 12px;
                }

                .order_section_body {
                    margin-bottom: 10px;
                    text-align: center;
                }

                .order_section_body td {
                    padding-top: 24px;
                    padding-bottom: 24px;
                }
            
                .order_section_header tr:nth-child(even) {
                    background-color: #F9F9F9;
                }
                
                .page_footer {
                    position: fixed;
                    bottom: -39mm;
                    left: 0;
                    width: 100%;
                    text-align: center;
                    font-size: 12px;
                    color: #6D6D6D;
                    margin-top: 24px;
                }

                /* .page_break{
                    display: block;
                    clear: both;
                    page-break-after: always;
                } */
        </style>
    </head>
    <body onload="number_pages()">
        <%= yield %>
    </body>
</html>